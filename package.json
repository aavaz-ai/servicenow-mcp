{
  "name": "@enterpret/servicenow-mcp",
  "version": "0.4.0",
  "description": "Enterpret's fork of onlyflowstech/servicenow-mcp. 17 tools over the ServiceNow Table API; adds a SERVICENOW_OAUTH_BEARER env mode so a broker-supplied (Nango) OAuth token is used for auth.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "servicenow-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "servicenow",
    "mcp",
    "model-context-protocol",
    "itsm",
    "itom",
    "cmdb",
    "claude",
    "cursor",
    "windsurf",
    "ai-tools"
  ],
  "author": "OnlyFlows <support@onlyflows.tech> (https://onlyflows.tech)",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/aavaz-ai/servicenow-mcp"
  },
  "homepage": "https://github.com/aavaz-ai/servicenow-mcp#readme",
  "bugs": {
    "url": "https://github.com/aavaz-ai/servicenow-mcp/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.0",
    "vitest": "^5.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
